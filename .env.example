# Next.js automatically reads this file after it is copied to .env.local.
# Either the data.go.kr encoding key or decoding key can be used.
MOEF_RECRUITMENT_API_KEY=

# Optional automatic synchronization settings.
MOEF_SYNC_INTERVAL_MINUTES=60
MOEF_SYNC_ROWS_PER_PAGE=100
MOEF_SYNC_MAX_PAGES=10

# Approved HRDKorea NCS information API. If omitted, the MOEF key is reused.
NCS_INFO_API_KEY=
MATCHING_AI_CANDIDATE_LIMIT=80

# Existing Firebase/Gemini settings still belong in .env.local.
# FIREBASE_SERVICE_ACCOUNT={...}
# GEMINI_API_KEY=
